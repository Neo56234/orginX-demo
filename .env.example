# OriginX — Environment Variables Template
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ─── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DATA_DIR=/data

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=dev
DATABASE_URL=postgresql://originx:dev@postgres:5432/originx

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Claude API (Anthropic) ───────────────────────────────────────────────────
# Get from: https://console.anthropic.com
# Required for: Adjudicator verdict synthesis
ANTHROPIC_API_KEY=sk-ant-...

# ─── YouTube Data API v3 ──────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → Enable YouTube Data API v3
# Free tier: 10,000 units/day
# Required for: Chronologist + Tracer duplicate search
YOUTUBE_API_KEY=AIza...

# ─── InVID / WeVerify API ─────────────────────────────────────────────────────
# Register at: https://weverify.eu
# Approval time: 2-7 days — apply on Day 1
# Required for: Tracer reverse video search
INVID_API_KEY=

# ─── Mapbox ───────────────────────────────────────────────────────────────────
# Get from: https://mapbox.com → Free tier: 50,000 map loads/month
# Required for: Frontend MapView component
MAPBOX_TOKEN=pk.eyJ1...

# ─── Twilio (WhatsApp Bot) ────────────────────────────────────────────────────
# Get from: https://twilio.com → WhatsApp Sandbox
# Required for: WhatsApp bot demo (T2 feature)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
